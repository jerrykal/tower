#!/bin/sh
# Every ssh session's command (sshd's ForceCommand): the environment of
# the simulated host its ssh name stands for, from the file the harness
# writes for the port it came in on, then the command as sshd runs it.
d=$(cat /etc/tt-env-dir 2>/dev/null)
f=$d/${SSH_CONNECTION##* }.env
[ -r "$f" ] && . "$f"
if [ -n "$SSH_ORIGINAL_COMMAND" ]; then
	exec /bin/sh -c "$SSH_ORIGINAL_COMMAND"
fi
exec /bin/sh -l
